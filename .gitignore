# El DAW es agnóstico al proyecto: solo el template site/example se versiona.
# Los sitios reales (site/<slug>) viven fuera del repo — aquí quedan ignorados.
# Dentro de site/example, site/.gitignore excluye los outputs generados
# (pages/, design-system/, content_state/).
site/*/
!site/example/

# Deprecated catalog templates (Divi 4 compiled)
workspace/catalog/
workspace/sections/catalog/

# Debug / scratch files
workspace/scratch/



# Generated module schemas
workspace/data/modules/

# Python cache
__pycache__/
*.pyc
*.pyo

# OS files
.DS_Store
Thumbs.db

# Environment
.env

# Temp
*.tmp
/tmp/

# Backup copy
workspace/automation/generate_brief copy.py

# Remote scripts (zipped, not tracked)
workspace/fix_remote.py
workspace/ftp_remote.py
workspace/split_export.py
workspace/ssh_cmd.py
workspace/ssh_test.py
workspace/wp_remote.py
workspace/remote-scripts.zip
